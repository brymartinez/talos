# GitHub
ENG_GITHUB_TOKEN=
# Comma-separated organization names. Set this, GITHUB_REPOS, or both.
GITHUB_ORGS=
# Comma-separated owner/repository names. Set this, GITHUB_ORGS, or both.
GITHUB_REPOS=
GITHUB_EXCLUDE_REPOS=
# Comma-separated team slugs. Empty discovers all your teams in the configured sources.
GITHUB_TEAM_ALLOWLIST=
GITHUB_MENTION_LOOKBACK_DAYS=90

# Local repositories and app data
# Comma-separated folders
REPO_ROOTS=~/Documents/projects
APP_DATA_DIR=~/.eng-work-board

# Agents
WORK_AGENT=codex
AGENT_CONCURRENCY=1

# Editor
CODE_COMMAND=code
